{{ 'custom-grid.css' | asset_url | stylesheet_tag }}

<div class="custom-grid-wrapper" id="custom-grid-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <div class="grid-text-display">
      <h2 class="grid-heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="grid-images-container">
    {% assign active_blocks = section.blocks %}
    {% if active_blocks.size == 0 %}
      {% assign loop_range = (1..6) %}
    {% else %}
      {% assign loop_range = active_blocks %}
    {% endif %}

    {% for item in loop_range limit: 6 %}
      {% if active_blocks.size > 0 %}
        {% assign block = item %}
        {% assign block_id = block.id %}
        {% assign custom_image = block.settings.image %}
        {% assign product = block.settings.product %}
        {% assign shopify_attrs = block.shopify_attributes %}
      {% else %}
        {% assign block = null %}
        {% assign block_id = 'default-' | append: forloop.index %}
        {% assign custom_image = null %}
        {% assign product = null %}
        {% assign shopify_attrs = '' %}
      {% endif %}

      {% assign default_asset_name = 'grid-image-' | append: forloop.index | append: '.jpg' %}

      <div class="grid-item" {{ shopify_attrs }}>
        <div class="grid-image-wrapper">
          {% if custom_image != blank %}
            <img
              src="{{ custom_image | image_url: width: 1200 }}"
              alt="{{ custom_image.alt | default: 'Grid Image' | escape }}"
              loading="lazy"
              class="grid-img"
              width=""
              height=""
            >
          {% else %}
            <img
              src="{{ default_asset_name | asset_url }}"
              alt="Default Grid Look {{ forloop.index }}"
              loading="lazy"
              class="grid-img"
              width=""
              height=""
            >
          {% endif %}

          <!-- Hotspot Toggle Button -->
          <button
            type="button"
            class="hotspot-btn"
            aria-label="View product details"
            data-popup-trigger="popup-{{ block_id }}"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>

        <!-- Product Modal Pop-up -->
        <div id="popup-{{ block_id }}" class="grid-modal" aria-hidden="true">
          <div class="grid-modal-overlay" data-popup-close></div>
          <div class="grid-modal-content">
            <button class="grid-modal-close" data-popup-close aria-label="Close popup">&times;</button>

            {% if product != blank %}
              <div class="modal-product-card">
                <!-- Top Row: Image & Key Details -->
                <div class="modal-product-header">
                  <div class="modal-product-media">
                    {% if custom_image != blank %}
                      <img src="{{ custom_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="" height="">
                    {% elsif product.featured_image != blank %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" height="" width="">
                    {% else %}
                      <img src="{{ default_asset_name | asset_url }}" alt="Default Grid Look {{ forloop.index }}" width="" height="">
                    {% endif %}
                  </div>

                  <div class="modal-product-info">
                    <h3 class="modal-title">{{ product.title }}</h3>
                    <p class="modal-price">{{ product.price | money }}</p>
                    {% if product.description != blank %}
                      <div class="modal-description">
                        {{ product.description | strip_html | truncatewords: 25 }}
                      </div>
                    {% endif %}
                  </div>
                </div>

                <!-- Product Form & Variant Options -->
                {% form 'product', product, class: 'modal-product-form' %}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

                  {% unless product.has_only_default_variant %}
                    {% for option in product.options_with_values %}
                      <div class="modal-option-group">
                        <label class="option-label">{{ option.name }}</label>

                        {% assign option_name_lower = option.name | downcase %}
                        {% if option_name_lower contains 'color' or option_name_lower contains 'colour' %}
                          <div class="color-swatch-container">
                            {% for value in option.values %}
                              <label class="color-swatch-option">
                                <input 
                                  type="radio" 
                                  name="options[{{ option.name | escape }}]" 
                                  value="{{ value | escape }}" 
                                  {% if option.selected_value == value %}checked{% endif %}
                                >
                                <span class="swatch-btn">{{ value }}</span>
                              </label>
                            {% endfor %}
                          </div>
                        {% else %}
                          <div class="select-wrapper">
                            <select name="options[{{ option.name | escape }}]" class="modal-select">
                              <option value="" disabled>Choose your {{ option.name | downcase }}</option>
                              {% for value in option.values %}
                                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                                  {{ value }}
                                </option>
                              {% endfor %}
                            </select>
                          </div>
                        {% endif %}
                      </div>
                    {% endfor %}
                  {% endunless %}

                  <button type="submit" class="modal-add-to-cart-btn">
                    <span>ADD TO CART</span>
                    <svg width="24" height="12" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="0" y1="6" x2="22" y2="6"></line>
                      <polyline points="16 1 22 6 16 11"></polyline>
                    </svg>
                  </button>
                {% endform %}
              </div>
            {% else %}
              <!-- Fallback View when no Product is attached -->
              <div class="modal-product-card">
                <div class="modal-product-header">
                  <div class="modal-product-media">
                    <img src="{{ default_asset_name | asset_url }}" alt="Default Grid Look {{ forloop.index }}" width="" height="">
                  </div>
                  <div class="modal-product-info">
                    <h3 class="modal-title">Sample Product Name</h3>
                    <p class="modal-price">980,00€</p>
                    <div class="modal-description">
                      This piece is crafted from premium fabric featuring detailed micro accents. Select a product in the theme editor to connect live data.
                    </div>
                  </div>
                </div>

                <div class="modal-option-group">
                  <label class="option-label">Color</label>
                  <div class="color-swatch-container">
                    <button type="button" class="swatch-btn active">White</button>
                    <button type="button" class="swatch-btn">Black</button>
                  </div>
                </div>

                <div class="modal-option-group">
                  <label class="option-label">Size</label>
                  <div class="select-wrapper">
                    <select class="modal-select">
                      <option>Choose your size</option>
                    </select>
                  </div>
                </div>

                <button type="button" class="modal-add-to-cart-btn">
                  <span>ADD TO CART</span>
                  <svg width="24" height="12" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="0" y1="6" x2="22" y2="6"></line>
                    <polyline points="16 1 22 6 16 11"></polyline>
                  </svg>
                </button>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script src="{{ 'custom-grid.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Custom Grid Section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop The Look"
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "Grid Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Card Image (Leave blank for asset default)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured Product (Pop-up Content)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image Grid",
      "blocks": [
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" },
        { "type": "grid_item" }
      ]
    }
  ]
}
{% endschema %}