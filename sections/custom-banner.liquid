<style>
{% comment %} This is the overall style for the Custom banner container {% endcomment %}
  .custom-banner-{{ section.id }} {
    width: 100%;
    max-width: 1440px;
    min-height: 878px;
    margin: 0 auto;
    position: relative;
    box-sizing: border-box;
    opacity: 1;
    overflow: hidden;
    background-color: #F5F5F5;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

{% comment %}  This is the beginning of the style for navbar {% endcomment %}
  /* Header Bar */
  .custom-banner-{{ section.id }} .banner-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  max-width: 1440px;
  min-height: 64px;
  padding: 10px 50px;
  background-color: #F5F5F5;
  box-sizing: border-box;
  opacity: 1;
  }

  .custom-banner-{{ section.id }} .brand-title {
  width: 151.44px;
  height: 19px;
  color: #000000;
  opacity: 1;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  }

  .custom-banner-{{ section.id }} .top-announcement {
  width: 260px;
  height: 14px;
  font-family: 'Jost', sans-serif;
  font-weight: 400;
  font-style: normal;
  font-size: 16px;
  line-height: 13.42px;
  letter-spacing: 0px;
  text-align: center;
  color: #000000;
  opacity: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  }

  .custom-banner-{{ section.id }} .btn-choose-gift {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #fffb00;
    color: #000;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid #000;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.3s ease, box-shadow 0.3s ease;
  }


  /* Hover Animation for Top Button */
  .custom-banner-{{ section.id }} .btn-choose-gift:hover {
   display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 207px;
  height: 44px;
  background-color: #FFF544;
  opacity: 1;
  text-decoration: none;
  box-sizing: border-box;
  }

.custom-banner-{{ section.id }} .btn-choose-gift > span:first-child {
  font-family: 'Jost', sans-serif;
  font-size: 16px;
  font-weight: 400;
  font-style: normal;
  line-height: 20.48px;
  letter-spacing: 0px;
  text-transform: uppercase;
  color: #000000;
  opacity: 1;
}

  .custom-banner-{{ section.id }} .btn-choose-gift .arrow {
  display: inline-block;
  width: 24px;
  height: 0;
  border-top: 1.5px solid #000000;
  color: #000000;
  opacity: 1;
  line-height: 1;
  }

  .custom-banner-{{ section.id }} .btn-choose-gift:hover .arrow {
    transform: translateX(5px);
  }

{% comment %}  This is the end of the style for navbar {% endcomment %}

{% comment %}  This is the beginning of the style for the Hero content {% endcomment %}

  /* Hero Content Area (Hug vertical content layout) */
  .custom-banner-{{ section.id }} .banner-hero-content {
    max-width: 520px;
    z-index: 2;
    padding: 60px 0;
    margin: auto 0;
  }

  .custom-banner-{{ section.id }} .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #000;
    margin: 0 0 20px 0;
  }

  .custom-banner-{{ section.id }} .hero-description {
    font-size: 16px;
    line-height: 1.5;
    color: #333;
    margin-bottom: 30px;
  }

  /* Shop Now Button Animation */
  .custom-banner-{{ section.id }} .btn-shop-now {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background-color: #000;
    color: #fff;
    padding: 16px 32px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
    border: none;
    min-width: 200px;
    transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .custom-banner-{{ section.id }} .btn-shop-now:hover {
    background-color: #222;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  }

  .custom-banner-{{ section.id }} .btn-shop-now .arrow {
    transition: transform 0.3s ease;
  }

  .custom-banner-{{ section.id }} .btn-shop-now:hover .arrow {
    transform: translateX(6px);
  }

{% comment %}  This is the end of the style for the Hero content {% endcomment %}

{% comment %}  This is the beginning of the style for the Footer {% endcomment %}

  /* Footer Tagline */
  .custom-banner-{{ section.id }} .banner-footer {
    text-align: center;
    z-index: 2;
  }

  .custom-banner-{{ section.id }} .footer-tagline {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #000;
    background: rgba(255, 255, 255, 0.9);
    padding: 6px 16px;
    border: 1px solid #000;
  }

{% comment %}  This is the end of the style for the Footer {% endcomment %}



  /* Responsive Rules */
  @media screen and (max-width: 768px) {
    .custom-banner-{{ section.id }} {
      min-height: auto;
      padding: 20px 16px;
    }

    .custom-banner-{{ section.id }} .banner-header {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
      text-align: center;
    }

    .custom-banner-{{ section.id }} .banner-hero-content {
      padding: 30px 0;
    }

    .custom-banner-{{ section.id }} .btn-shop-now {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>



{% comment %} Beginning of The HTML Files {% endcomment %}
{% comment %} Overall Div conainer for the Custom Banner Section {% endcomment %}

<div class="custom-banner-{{ section.id }}">
{% comment %} The Navigation Header {% endcomment %}
  <div class="banner-header">
    <div class="brand-title">
      {{ section.settings.brand_text }}
    </div>

    {% if section.settings.announcement_text != blank %}
      <div class="top-announcement">
        {{ section.settings.announcement_text }}
      </div>
    {% endif %}

    <a href="{{ section.settings.button_top_url | default: '#' }}" class="btn-choose-gift">
      <span>{{ section.settings.button_top_text }}</span>
      <span class="arrow">&rarr;</span>
    </a>
  </div>

  {% comment %} Main Hero Content {% endcomment %}
  <div class="banner-hero-content">
    <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
    <div class="hero-description">{{ section.settings.hero_description }}</div>
    <a href="{{ section.settings.button_main_url | default: '#' }}" class="btn-shop-now">
      <span>{{ section.settings.button_main_text }}</span>
      <span class="arrow">&rarr;</span>
    </a>
  </div>

  {% comment %} The Bottom Tagline {% endcomment %}
  <div class="banner-footer">
    <div class="footer-tagline">
      {{ section.settings.footer_tagline }}
    </div>
  </div>

</div>

{% comment %} End of The HTML Files {% endcomment %}

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Illustration Graphic"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Top Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_top_text",
      "label": "Top Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_top_url",
      "label": "Top Button Link"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Main Hero Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_main_text",
      "label": "Main Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_main_url",
      "label": "Main Button Link"
    },
    {
      "type": "text",
      "id": "footer_tagline",
      "label": "Footer Tagline",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
