{{ 'custom-banner.css' | asset_url | stylesheet_tag }}

<div id="customBannerSection" class="custom-banner-section">

  
   {%-  comment %} Top Header Bar  {%-  endcomment %}
  <div id="bannerHeader" class="banner-header">


<div id="brandTitle" class="brand-title">
  {%- if section.settings.brand_image != blank -%}
    {{ section.settings.brand_image | image_url: width: 300 | image_tag: 
      class: 'brand-logo-img',
      alt: section.settings.brand_image.alt | default: shop.name,
      loading: 'eager'
    }}
  {%- else -%}
    <img 
      src="{{ 'LogoFont.svg' | asset_url }}" 
      class="brand-logo-img" 
      alt="{{ shop.name }}" 
      loading="eager"
      width="151" 
      height="19"
    >
  {%- endif -%}
</div>
    

     {%-  if section.settings.announcement_text != blank -%}
      <div class="top-announcement">
          {{ section.settings.announcement_text }}  
      </div>
     {%-  endif -%}

    <a href="{{ section.settings.button_top_url | default: '#' }}" class="btn-choose-gift">
      <span>{{ section.settings.button_top_text }}</span>
      <img 
        src="{{ 'arrow.svg' | asset_url }}" 
        alt="arrow-icon" 
        class="arrow-icon"
        width="20"
        height="20"
        loading="lazy"
      >
    </a>
  </div>

   {%-  comment -%} 1. Upper Image (Full Width) - Direct Child  {%-  endcomment -%}
  <div class="banner-top-image">
     {%-  if section.settings.top_image != blank -%}
      <img 
        src="{{ section.settings.top_image | image_url: width: 2000 }}" 
        alt="{{ section.settings.top_image.alt | default: 'Hero Top Graphic' | escape }}" 
        width="{{ section.settings.top_image.width }}"
        height="{{ section.settings.top_image.height }}"
        loading="eager"
      >
     {%-  else -%}
      <img 
        src="{{ 'Hero-Background.svg' | asset_url }}" 
        alt="Hero Top Graphic" 
        width="1440"
        height="390"
        loading="eager"
      >
     {%-  endif -%}
  </div>

   {%-  comment -%} 2. Lower Row (Left Content + Right Image) - Direct Child  {%-  endcomment -%}
  <div class="banner-bottom-row">
    
     {%-  comment -%} Lower Left Text Box  {%-  endcomment -%}
    <div class="banner-hero-content">
       {%-  if section.settings.hero_title != blank -%}
        <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
       {%-  endif -%}
      
       {%-  if section.settings.hero_description != blank -%}
        <div class="hero-description">{{ section.settings.hero_description }}</div>
       {%-  endif -%}

       {%-  if section.settings.button_main_text != blank -%}
        <a href="{{ section.settings.button_main_url | default: '#' }}" class="btn-shop-now">
          <span>{{ section.settings.button_main_text }}</span>
            <img 
          src="{{ 'arrow.svg' | asset_url }}" 
          alt="arrow-icon" 
          class="arrow"
          width="20"
          height="20"
          loading="lazy"
        >
        </a>
       {%-  endif -%}
    </div>

     {%-  comment -%} Lower Right Image  {%-  endcomment -%}
    <div id="bannerBottomImage" class="banner-bottom-image">
       {%-  if section.settings.bottom_image != blank -%}
        <img 
          src="{{ section.settings.bottom_image | image_url: width: 1600 }}" 
          alt="{{ section.settings.bottom_image.alt | default: 'Hero Bottom Graphic' | escape }}" 
          width="{{ section.settings.bottom_image.width }}"
          height="{{ section.settings.bottom_image.height }}"
          loading="lazy"
          id="bottomImage"
        >
       {%-  else -%}
        <img 
          src="{{ 'Hero-Background.svg' | asset_url }}" 
          alt="Hero Bottom Graphic" 
          width="1000"
          height="500"
          loading="lazy"
        >
       {%-  endif -%}
    </div>

  </div>


   {%-  comment -%} Bottom Tagline  {%-  endcomment -%}
  <div class="banner-footer">
     {%-  if section.settings.footer_tagline != blank -%}
      <div id="footerTagline" class="footer-tagline">
        {{ section.settings.footer_tagline }}
      </div>
     {%-  endif -%}
  </div>

</div>


<script src="{{ 'custom-banner.js' | asset_url }}" defer="defer"></script>

{%- schema -%}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Brand Logo Image",
      "info": "Upload a custom logo image. If left blank, the default LogoFont.svg asset will be used."
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Top Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "image_picker",
      "id": "announcement_image",
      "label": "Announcement Image"
    },
    {
      "type": "text",
      "id": "button_top_text",
      "label": "Top Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_top_url",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Upper Full-Width Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_main_text",
      "label": "Main Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_main_url",
      "label": "Main Button Link"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Lower Right Image"
    },
    {
      "type": "text",
      "id": "footer_tagline",
      "label": "Footer Tagline",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{%- endschema -%}