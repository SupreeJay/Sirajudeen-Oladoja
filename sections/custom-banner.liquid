<style>

/* Paste this at the VERY top of your CSS file */
@import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;700&display=swap');

/* Brand Title CSS */
.brand-title {
  font-family: 'Jost', sans-serif;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #000000;
  white-space: nowrap;
}

{% comment %} Overall style for the Custom banner container {% endcomment %}
  .custom-banner-{{ section.id }} {
    width: 100%;
    max-width: 1440px;
    min-height: 878px;
    margin: 0 auto;
    position: relative;
    box-sizing: border-box;
    opacity: 1;
    overflow: hidden;
    background-color: #F5F5F5;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 0 20px 0;
  }

{% comment %} Style for navbar {% endcomment %}
  /* Header Bar */
  .custom-banner-{{ section.id }} .banner-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1440px;
    min-height: 64px;
    padding: 10px 50px;
    background-color: transparent;
    box-sizing: border-box;
    opacity: 1;
  }

  .custom-banner-{{ section.id }} .brand-title {
    font-family: 'Jost', sans-serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #000000;
    white-space: nowrap;
    width: 151.44px;
    height: 19px;
    opacity: 1;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .custom-banner-{{ section.id }} .top-announcement {
    width: auto;
    height: 14px;
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 13.42px;
    letter-spacing: 0px;
    text-align: center;
    color: #000000;
    opacity: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .custom-banner-{{ section.id }} .btn-choose-gift {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #fffb00;
    color: #000000;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    border: 1px solid #000000;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Hover Animation for Top Button */
  .custom-banner-{{ section.id }} .btn-choose-gift:hover {
    color: #ffffff;
    background-color: #000000;
  }

  .custom-banner-{{ section.id }} .btn-choose-gift > span:first-child {
    font-family: 'Jost', sans-serif;
    font-size: 16px;
    font-weight: 400;
    font-style: normal;
    line-height: 20.48px;
    letter-spacing: 0px;
    text-transform: uppercase;
    color: #000000;
    opacity: 1;
    transition: color 0.3s ease;
  }

  .custom-banner-{{ section.id }} .btn-choose-gift:hover > span:first-child {
    color: #ffffff;
  }

  .custom-banner-{{ section.id }} .btn-choose-gift .arrow-icon {
    display: inline-block;
    width: 24px;
    height: auto;
    opacity: 1;
    line-height: 1;
    object-fit: contain;
    will-change: transform, filter;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), filter 0.3s ease;
    filter: brightness(0);
  }

  .custom-banner-{{ section.id }} .btn-choose-gift:hover .arrow-icon {
    transform: translateX(6px);
    filter: brightness(0) invert(1);
  }

  /* Hero Content Area */
  .custom-banner-{{ section.id }} .banner-hero-content {
    max-width: 520px;
    z-index: 2;
    padding: 60px 50px;
    margin: auto 0;
  }

  .custom-banner-{{ section.id }} .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #000000;
    margin: 0 0 20px 0;
  }

  .custom-banner-{{ section.id }} .hero-description {
    font-size: 16px;
    line-height: 1.5;
    color: #333333;
    margin-bottom: 30px;
  }

  /* Shop Now Button Animation */
  .custom-banner-{{ section.id }} .btn-shop-now {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background-color: #000000;
    color: #ffffff;
    padding: 16px 32px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-decoration: none;
    text-transform: uppercase;
    border: none;
    min-width: 200px;
    transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .custom-banner-{{ section.id }} .btn-shop-now:hover {
    background-color: #222222;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.25);
  }

  .custom-banner-{{ section.id }} .btn-shop-now .arrow {
    transition: transform 0.3s ease;
  }

  .custom-banner-{{ section.id }} .btn-shop-now:hover .arrow {
    transform: translateX(6px);
  }

  /* Footer Tagline */
  .custom-banner-{{ section.id }} .banner-footer {
    text-align: center;
    z-index: 2;
  }

  .custom-banner-{{ section.id }} .footer-tagline {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #000000;
    background: rgba(255, 255, 255, 0.9);
    padding: 6px 16px;
    border: 1px solid #000000;
  }

  /* Responsive Rules */
  @media screen and (max-width: 768px) {
    .custom-banner-{{ section.id }} {
      min-height: auto;
      padding: 20px 16px;
    }

    .custom-banner-{{ section.id }} .banner-header {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
      text-align: center;
      padding: 10px 0;
    }

    .custom-banner-{{ section.id }} .banner-hero-content {
      padding: 30px 0;
    }

    .custom-banner-{{ section.id }} .btn-shop-now {
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>

<div class="custom-banner-{{ section.id }}" style="{% if section.settings.bg_image != blank %}background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% endif %}">
  
  {% comment %} The Navigation Header {% endcomment %}
  <div class="banner-header">
    <div class="brand-title">
      {{ section.settings.brand_text }}
    </div>

    {% if section.settings.announcement_text != blank %}
      <div class="top-announcement">
        {{ section.settings.announcement_text }}
      </div>
    {% endif %}

    <a href="{{ section.settings.button_top_url | default: '#' }}" class="btn-choose-gift">
      <span>{{ section.settings.button_top_text }}</span>
      <img 
        src="{{ 'arrow.svg' | asset_url }}" 
        alt="arrow-icon" 
        class="arrow-icon"
        width="20"
        height="20"
        loading="lazy"
      >
    </a>
  </div>

  {% comment %} Main Hero Content {% endcomment %}
  <div class="banner-hero-content">
    {% if section.settings.hero_title != blank %}
      <h1 class="hero-title">{{ section.settings.hero_title }}</h1>
    {% endif %}
    {% if section.settings.hero_description != blank %}
      <div class="hero-description">{{ section.settings.hero_description }}</div>
    {% endif %}
    {% if section.settings.button_main_text != blank %}
      <a href="{{ section.settings.button_main_url | default: '#' }}" class="btn-shop-now">
        <span>{{ section.settings.button_main_text }}</span>
        <span class="arrow">&rarr;</span>
      </a>
    {% endif %}
  </div>

  {% comment %} The Bottom Tagline {% endcomment %}
  <div class="banner-footer">
    {% if section.settings.footer_tagline != blank %}
      <div class="footer-tagline">
        {{ section.settings.footer_tagline }}
      </div>
    {% endif %}
  </div>

</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Illustration Graphic"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Logo Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Top Announcement Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_top_text",
      "label": "Top Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "button_top_url",
      "label": "Top Button Link"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Main Hero Title",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_main_text",
      "label": "Main Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_main_url",
      "label": "Main Button Link"
    },
    {
      "type": "text",
      "id": "footer_tagline",
      "label": "Footer Tagline",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}